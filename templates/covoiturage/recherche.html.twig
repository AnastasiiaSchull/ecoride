{% extends 'base.html.twig' %}

{% block title %}Recherche de covoiturage - EcoRide{% endblock %}

{% block body %}


<div class="container py-5">

{# ================= SEARCH FORM ================= #}
{# DEPARTURE CHOICE #}
<form method="GET" action="{{ path('covoiturage_search') }}" class="mb-4">
    <div class="row g-3 align-items-end justify-content-center">
        <div class="col-md-3">
            <label class="form-label fw-bold">Départ</label>
            <select name="depart" class="form-select">
                <option value="">Choisir une ville</option>
                {% for ville in villesDepart|default([]) %}
                    <option value="{{ ville }}"
                        {% if depart is defined and depart == ville %}selected{% endif %}>
                        {{ ville }}
                    </option>
                {% endfor %}
            </select>
        </div>
         <br>
        {# DESTINATION CHOICE #}
        <div class="col-md-3">
            <label class="form-label fw-bold">Destination</label>
            <select name="destination" class="form-select">
                <option value="">Choisir une ville</option>
                {% for ville in villesArrivee|default([]) %}
                    <option value="{{ ville }}"
                        {% if destination is defined and destination == ville %}selected{% endif %}>
                        {{ ville }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <br>
        {# DATE #}
        <div class="col-md-2">
            <label class="form-label">Date</label>
            <input type="date"
                   name="date"
                   class="form-control"
                   value="{{ date|default('now'|date('Y-m-d')) }}">
        </div>

        <div class="col-md-2">
            <label class="form-label">Passagers</label>
            <input type="number"
                   name="passager"
                   min="1"
                   max="8"
                   class="form-control"
                   value="{{ passager|default(1) }}">
        </div>
        <br>
        <div class="col-md-2">
              <div class="d-grid mt-3">
                <button type="submit" class="btn btn-primary">
                    Rechercher
                </button>
            </div>
        </div>

    </form>

    {# ================= TITLE ================= #}
    <h3 class="mt-5 mb-3">
        Résultats — {{ trajetTitre|default('Trajets') }}
    </h3>

    {# ================= RESULTS ================= #}
    {% if trajets is empty %}

        <div class="alert alert-warning">
            Aucun trajet trouvé pour cette recherche.
        </div>

    {% else %}

        <div class="row g-3">

            {% for trajet in trajets %}

                <div class="col-12">

                    <div class="card shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between">

                                {# TIMES #}
                                <div>

                                    <div class="fw-bold">
                                        {{ trajet.dateDepart|date('H:i') }}
                                        →
                                        {{ trajet.dateArrivee|date('H:i') }}
                                    </div>

                                    <div class="text-muted">
                                        {{ trajet.villeDepart }}
                                        →
                                        {{ trajet.villeArrivee }}
                                    </div>

                                </div>

                                {# PRIX #}
                                <div class="text-end">
                                    <h4 class="text-primary mb-0">
                                        {{ trajet.prix }} €
                                    </h4>
                                </div>

                            </div>

                            <hr>

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <div>
                                        Conducteur :
                                        <strong>{{ trajet.conducteur_nom|default('—') }}</strong>
                                        ⭐ {{ trajet.conducteur_note|default('–') }}
                                    </div>

                                    <div>
                                        Places restantes :
                                        {{ trajet.placesDispo }}
                                    </div>
                                </div>
                                <br>
                                <div class="d-flex gap-2">

                                    <a href="{{ path('trajet_details', {id: trajet.id}) }}"
                                       class="btn btn-outline-primary btn-sm">
                                        Détails
                                    </a>
                                    <br><br>
                                    {% if trajet.placesDispo > 0 %}

                                        {% if app.user %}

                                            <form method="post" action="{{ path('reservation_create') }}">
                                                <input type="hidden" name="trajet_id" value="{{ trajet.id }}">
                                                <button class="btn btn-primary btn-sm">
                                                    Réserver
                                                </button>
                                            </form>

                                        {% else %}
                                        <br>
                                            <a href="{{ path('login') }}"
                                               class="btn btn-secondary btn-sm">
                                                Connexion
                                            </a>

                                        {% endif %}

                                    {% else %}

                                        <button class="btn btn-dark btn-sm" disabled>
                                            Complet
                                        </button>

                                    {% endif %}

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            {% endfor %}

        </div>

    {% endif %}

</div>

{% endblock %}