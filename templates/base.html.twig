<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
      <link rel="icon" type="image/svg+xml"
              href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'>
              <text y='1.2em' font-size='96'>⚫️</text>
              <text y='1.3em' x='0.2em' font-size='76' fill='white'>sf</text>
              </svg>">

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

        {% block stylesheets %}
          {{ encore_entry_link_tags('app') }}
        <style>
           .hero-banner {
                width: 100%;
                margin: 0;
                padding-bottom: 10px;
                border-top: 2px solid black;
                border-bottom: 2px solid black;
                background-color: darkgray;
                color: black;
                position: relative; /* IMPORTANT */
            }

            .hero-banner img {
                width: 100%;
                height: 180px;
                display: block;
                object-fit: cover;
                border-bottom: 2px solid black;
            }

            .titleXXX {
                display: flex;
                justify-content: center;
                width: 100%;
                margin-top: 10px;
            }

            .hero-login {
                position: absolute;
                text-decoration: none;
                top: 200px;
                right: 20px;
                z-index: 10;
            }

            .hero-login2 {
                position: absolute;
                text-decoration: none;
                top: 200px;
                right: 150px;
                z-index: 10;
            }

            .footer-ecoride {
                display: flex;
                width: 100%;
                color: black;
            }

            .footer-ecoride a {
                color: black;
                font-weight: 500;
            }

            .footer-ecoride a:hover {
                text-decoration: underline !important;
            }
        </style>

        {% endblock %}

        {% block javascripts %}
             {{ encore_entry_script_tags('app') }}
        {% endblock %}

        {% set frankenphpHotReload =
            app.request is defined and app.request
            ? app.request.server.get('FRANKENPHP_HOT_RELOAD')
            : null
        %}

        {% if frankenphpHotReload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>

    <body>
        <div class="hero-banner position-relative">

            <img src="{{ asset('images/hero.jpg') }}"
                alt="Hero">

            <div class="titleXXX">
                <h1>
                    EcoRide,
                    le covoiturage simple et écologique.
                </h1>

             </div>

                {% if is_granted('ROLE_ADMIN') %}
                    <div>
                    <a href="{{ path('admin_dashboard') }}" class="btn btn-primary hero-login2">
                        Dashboard
                    </a>
                     <a href="{{ path('logout') }}" id="logout-link" class="btn btn-danger hero-login">
                        Déconnexion
                    </a>
                    </div>
                {% elseif app.user %}
                    {# utilisateur connecté non admin #}
                {% else %}
                    <a href="{{ path('login') }}" class="btn btn-primary hero-login">
                        Se connecter
                    </a>
                {% endif %}

        </div>

        {% block body %} {% endblock %}

        <footer class="footer-ecoride mt-5">
            <div class="container py-3">
                <div class="row align-items-center text-center text-md-start">

                    <div class="col-md-4 mb-2 mb-md-0">
                        <a href="#"
                        class="text-dark text-decoration-none">
                            Mentions légales
                        </a>
                    </div>

                    <div class="col-md-4 mb-2 mb-md-0 text-center">
                        <a href="#"
                        class="text-dark text-decoration-none">
                            Politique de confidentialité
                        </a>
                    </div>

                    <div class="col-md-4 text-center text-md-end">
                        <a href="#"
                        class="text-dark text-decoration-none">
                            Nous contacter
                        </a>
                    </div>

                </div>

                <hr class="my-3">

                <div class="text-center">
                    © {{ "now"|date("Y") }} ECORIDE - Tous droits réservés
                </div>
            </div>
        </footer>
              <script>
              document.addEventListener('DOMContentLoaded', function () {

              const logoutBtn = document.getElementById('logout-link');

              if (!logoutBtn) return;

              logoutBtn.addEventListener('click', function (e) {
                     e.preventDefault(); // 👈 IMPORTANT

                     Swal.fire({
                     title: 'Déconnexion',
                     text: 'Voulez-vous vraiment quitter votre session ?',
                     icon: 'warning',

                     showCancelButton: true,
                     confirmButtonText: 'Oui',
                     cancelButtonText: 'Annuler',

                     buttonsStyling: false,

                     customClass: {
                            popup: 'glass-popup',
                            title: 'glass-title',
                            htmlContainer: 'glass-html',
                            confirmButton: 'btn btn-danger mx-2 px-4',
                            cancelButton: 'btn btn-secondary mx-2 px-4'
                     }
                     }).then((result) => {
                     if (result.isConfirmed) {
                            window.location.href = logoutBtn.href;
                     }
                     });
              });

              });
       </script>
         <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
         <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    </body>
</html>