{% extends 'base.html.twig' %}

{% block title %}Écrire un avis{% endblock %}

{% block body %}

<div class="container py-5" style="max-width: 700px;">

    <h2 class="mb-4">Écrire un avis</h2>

    <div class="alert alert-light border mb-4">

        <strong>Trajet :</strong>
        {{ reservation.trajet.villeDepart }}
        →
        {{ reservation.trajet.villeArrivee }}

        <br>

        <strong>Date :</strong>
        {{ reservation.trajet.dateDepart|date('d/m/Y H:i') }}

    </div>

    <form method="post" action="{{ path('avis_store') }}">

        <input type="hidden"
               name="reservation_id"
               value="{{ reservation.id }}">

        <div class="mb-3">

            <label class="form-label">
                Note
            </label>

            <select name="note"
                    class="form-select"
                    required>

                {% for i in 5..1 %}
                    <option value="{{ i }}">
                        {{ i }}/5
                    </option>
                {% endfor %}

            </select>

        </div>

        <div class="mb-3">

            <label class="form-label">
                Commentaire
            </label>

            <textarea name="commentaire"
                      class="form-control"
                      rows="5"
                      required></textarea>

        </div>

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">
                Envoyer l'avis
            </button>

            <a href="{{ path('reservation_my') }}"
               class="btn btn-outline-secondary">
                Annuler
            </a>

        </div>

    </form>

</div>

{% endblock %}