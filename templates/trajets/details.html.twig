{% extends 'base.html.twig' %}

{% block title %}Mes trajets{% endblock %}

{% block body %}

<div class="container py-5">

    <h2 class="mb-4">Mes trajets</h2>

    {% if trajets is empty %}
        <div class="alert alert-info">
            Aucun trajet trouvé.
        </div>
    {% endif %}

    {% for trajet in trajets %}

        <div class="card shadow mb-4">

            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">
                    {{ trajet.villeDepart }} → {{ trajet.villeArrivee }}
                </h5>
            </div>

            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Départ :</strong><br>
                        {{ trajet.villeDepart }}
                    </div>

                    <div class="col-md-6">
                        <strong>Arrivée :</strong><br>
                        {{ trajet.villeArrivee }}
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Date départ :</strong><br>
                        {{ trajet.dateDepart|date('d/m/Y H:i') }}
                    </div>

                    <div class="col-md-6">
                        <strong>Date arrivée :</strong><br>
                        {{ trajet.dateArrivee|date('d/m/Y H:i') }}
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <strong>Prix :</strong><br>
                        {{ trajet.prix }} €
                    </div>

                    <div class="col-md-4">
                        <strong>Places :</strong><br>
                        {{ trajet.placesDispo }}
                    </div>

                    <div class="col-md-4">
                        <strong>Éco :</strong><br>
                        {% if trajet.eco %}
                            <span class="badge bg-success">Oui</span>
                        {% else %}
                            <span class="badge bg-secondary">Non</span>
                        {% endif %}
                    </div>
                </div>

            </div>
        </div>

    {% endfor %}
    {# ===================== BUTTON RETOUR ===================== #}
    <div class="mt-4 text-center">
        <a href="{{ path('profile_dashboard') }}" class="btn btn-outline-secondary">
            ← Retour au profil
        </a>
    </div>
</div>

{% endblock %}