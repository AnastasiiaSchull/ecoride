<div id="cookie-banner" data-controller="cookie"
     class="position-fixed bottom-0 start-0 w-100 bg-dark text-white p-3 shadow">
    
    <div class="container-fluid">
        <div class="row align-items-center">
            
            <div class="col-12 col-md-8 mb-2 mb-md-0">
                Ce site utilise des cookies pour améliorer votre expérience. Vous pouvez accepter ou refuser notre politique les concernant.
            </div>

            <div class="col-12 col-md-4">
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button id="" class="btn btn-success" >
                        Personnaliser les paramètres des cookies
                    </button>
                    <button id="accept-cookies" class="btn btn-success"  data-action="click->cookie#accept">
                        Accepter et poursuivre
                    </button>
                    <button id="refuse-cookies" class="btn btn-outline-light"  data-action="click->cookie#refuse">
                        Tout refuser
                    </button>
                </div>
            </div>

        </div>
    </div>

</div>