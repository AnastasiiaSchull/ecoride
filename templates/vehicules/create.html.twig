{% extends 'base.html.twig' %}

{% block title %}Ajouter un véhicule{% endblock %}

{% block body %}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm">
                <div class="card-header">
                    <h2 class="mb-0">Ajouter un véhicule</h2>
                </div>

                <div class="card-body">

                    {% if errors is defined and errors %}
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                {% for error in errors %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('profile_vehicule_store') }}">

                        <div class="mb-3">
                            <label for="marque" class="form-label">Marque</label>
                            <input
                                type="text"
                                id="marque"
                                name="marque"
                                class="form-control"
                                required
                                value="{{ old.marque|default('') }}"
                            >
                        </div>

                        <div class="mb-3">
                            <label for="modele" class="form-label">Modèle</label>
                            <input
                                type="text"
                                id="modele"
                                name="modele"
                                class="form-control"
                                required
                                value="{{ old.modele|default('') }}"
                            >
                        </div>

                        <div class="mb-3">
                            <label for="couleur" class="form-label">Couleur</label>
                            <input
                                type="text"
                                id="couleur"
                                name="couleur"
                                class="form-control"
                                required
                                value="{{ old.couleur|default('') }}"
                            >
                        </div>

                        <div class="mb-3">
                            <label for="energie" class="form-label">Énergie</label>
                            <select
                                id="energie"
                                name="energie"
                                class="form-select"
                                required
                            >
                                <option value="">-- Choisir --</option>

                                <option value="essence"
                                    {{ old.energie|default('') == 'essence' ? 'selected' }}>
                                    Essence
                                </option>

                                <option value="diesel"
                                    {{ old.energie|default('') == 'diesel' ? 'selected' }}>
                                    Diesel
                                </option>

                                <option value="electrique"
                                    {{ old.energie|default('') == 'electrique' ? 'selected' }}>
                                    Électrique
                                </option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label for="places" class="form-label">
                                Places disponibles
                            </label>

                            <input
                                type="number"
                                id="places"
                                name="places"
                                min="1"
                                required
                                class="form-control"
                                value="{{ old.places|default(1) }}"
                            >
                        </div>

                        <div class="mb-4">
                            <label class="form-label">
                                Préférences du véhicule
                            </label>

                            {% for p in preferences %}
                                <div class="form-check">

                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        name="preferences[]"
                                        value="{{ p.id }}"
                                        id="pref{{ p.id }}"
                                        {% if old.preferences is defined and p.id in old.preferences %}
                                            checked
                                        {% endif %}
                                    >

                                    <label class="form-check-label" for="pref{{ p.id }}">
                                        {{ p.nom|capitalize }}
                                    </label>

                                </div>
                            {% endfor %}
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit" class="btn btn-success">
                                Valider
                            </button>

                            <a href="{{ path('profile_dashboard') }}"
                               class="btn btn-outline-secondary">
                                Annuler
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

{% endblock %}