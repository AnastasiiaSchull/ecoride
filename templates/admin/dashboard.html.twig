{% extends 'base.html.twig' %}

{% block title %}Admin{% endblock %}

{% block body %}

<div class="container-fluid p-0">


    <div class="container py-4">

        <h2 class="mb-4">Bienvenue, {{ app.user.pseudo }}</h2>

        {# FLASH #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}
        {# ================= ESPACE MODERATION ================= #}
        <div class="card mb-3">

            <div class="card-header"
                data-bs-toggle="collapse"
                data-bs-target="#gestionAvis"
                style="cursor:pointer;">

                ⭐ Validation des avis
            </div>

            <div id="gestionAvis" class="collapse">

                <div class="card-body">

                    <a href="{{ path('admin_avis') }}"
                    class="btn btn-warning w-100">

                        Consulter les avis en attente
                    </a>

                </div>

            </div>

        </div>

        {# ================= CREATE EMPLOYEE ================= #}
        <div class="card mb-3">

            <div class="card-header" data-bs-toggle="collapse" data-bs-target="#createEmp" style="cursor:pointer;">
                👤 Créer un employé
            </div>

            <div id="createEmp" class="collapse">
                <div class="card-body">

                    <form method="post" action="{{ path('admin_employes_create') }}">

                        <input class="form-control mb-2" name="pseudo" placeholder="Pseudo" required>
                        <input class="form-control mb-2" name="email" type="email" placeholder="Email" required>
                        <input class="form-control mb-2" name="password" type="password" placeholder="Mot de passe" required>
                        <input class="form-control mb-3" name="confirm_password" type="password" placeholder="Confirmation" required>

                        <button class="btn btn-primary w-100">
                            Créer
                        </button>

                    </form>

                </div>
            </div>

        </div>

        {# ================= TRAJETS ================= #}
        <div class="card mb-3">

            <div class="card-header" data-bs-toggle="collapse" data-bs-target="#trajetsChartBlock" style="cursor:pointer;">
                🚌 Trajets par jour
            </div>

            <div id="trajetsChartBlock" class="collapse show">
                <div class="card-body">
                    <canvas id="trajetsChart"></canvas>
                </div>
            </div>

        </div>

        {# ================= CREDITS ================= #}
        <div class="card mb-3">

            <div class="card-header" data-bs-toggle="collapse" data-bs-target="#creditsChartBlock" style="cursor:pointer;">
                📊 Crédits gagnés
            </div>

            <div id="creditsChartBlock" class="collapse">
                <div class="card-body">
                    <canvas id="creditsChart"></canvas>
                </div>
            </div>

        </div>

        {# ================= STATS ================= #}
        <div class="card mb-3">

            <div class="card-header" data-bs-toggle="collapse" data-bs-target="#statsBlock" style="cursor:pointer;">
                📋 Statistiques générales
            </div>

            <div id="statsBlock" class="collapse">
                <div class="card-body">
                    <p class="mb-0">
                        Total crédits plateforme :
                        <strong>{{ platformCredits|default(0) }}</strong>
                    </p>
                </div>
            </div>

        </div>

        {# ================= USERS ================= #}
        <div class="card mb-3">

            <div class="card-header" data-bs-toggle="collapse" data-bs-target="#usersBlock" style="cursor:pointer;">
                🚫 Suspension de comptes
            </div>

            <div id="usersBlock" class="collapse">
                <div class="card-body table-responsive">

                    <table class="table table-striped align-middle">

                        <thead>
                        <tr>
                            <th>Pseudo</th>
                            <th>Email</th>
                            <th>Crédits</th>
                            <th>Action</th>
                        </tr>
                        </thead>

                        <tbody>
                        {% for u in users|default([]) %}
                            <tr>
                                <td>{{ u.pseudo }}</td>
                                <td>{{ u.email }}</td>
                                <td>{{ u.credits }}</td>
                                <td>
                                    {% if not u.isActive %}
                                        <span class="badge bg-secondary me-2">Suspendu</span>
                                    {% endif %}

                                    <form method="post"
                                        action="{{ path('admin_user_toggle') }}"
                                        class="d-inline"
                                        onsubmit="return confirm('Confirmer cette action ?');">

                                        <input type="hidden" name="id" value="{{ u.id }}">

                                        {% if u.isActive %}
                                            <button class="btn btn-danger btn-sm">
                                                Suspendre
                                            </button>
                                        {% else %}
                                            <button class="btn btn-success btn-sm">
                                                Réactiver
                                            </button>
                                        {% endif %}

                                    </form>

                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>

                    </table>

                </div>
            </div>

        </div>

    </div>
</div>

{% block javascripts %}
    {{ parent() }}

    <script>
        window.chartData = {
            trajets: {{ trajetsData|default({})|json_encode|raw }},
            credits: {{ creditsData|default({})|json_encode|raw }}
        };
    </script>
{% endblock %}

{# ================= CHARTS ================= #}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

{% endblock %}