{% extends 'base.html.twig' %}

{% block title %}Écrire un avis{% endblock %}

{% block body %}

<div class="container py-5" style="max-width: 700px;">

    <h2 class="mb-4">Écrire un avis</h2>

    {# TRAJET INFOS #}
    <div class="alert alert-light border mb-4">

        <strong>Trajet :</strong>
        {{ reservation.villeDepart }}
        →
        {{ reservation.villeArrivee }}

        <br>

        <strong>Date :</strong>
        {{ reservation.dateDepart|date('d/m/Y H:i') }}

    </div>

    {# FORM #}
    <form method="post" action="{{ path('app_avis_create') }}">

        <input type="hidden" name="reservation_id" value="{{ reservation.id }}">

        {# NOTE #}
        <div class="mb-3">
            <label class="form-label">Note</label>

            <select name="note" class="form-select" required>
                {% for i in 5..1 %}
                    <option value="{{ i }}">{{ i }}</option>
                {% endfor %}
            </select>
        </div>

        {# COMMENTAIRE #}
        <div class="mb-3">
            <label class="form-label">Commentaire</label>
            <textarea name="commentaire"
                      class="form-control"
                      rows="5"
                      required></textarea>
        </div>

        {# ACTIONS #}
        <div class="d-flex gap-2">

            <button type="submit" class="btn btn-primary">
                Envoyer
            </button>

            <a href="{{ path('app_reservations') }}" class="btn btn-outline-secondary">
                Annuler
            </a>

        </div>

    </form>

</div>

{% endblock %}