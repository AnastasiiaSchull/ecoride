<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}EcoRide{% endblock %}</title>

    <link rel="icon" href="{{ asset('favicon.ico') }}">

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

</head>

<body class="bg-light">

{# NAVBAR #}
<nav class="navbar navbar-dark bg-dark px-3 d-flex align-items-center justify-content-between">

    <!-- GAUCHE -->
    <div class="d-flex align-items-center gap-2">
        <a class="navbar-brand fw-bold">
            EcoRide
        </a>

        <img src="{{ asset('favicon.ico') }}" class="logo" alt="favicon">

        <span class="ms-2">
            <span id="auth-led" class="led-indicator {{ app.user ? 'led-on' : 'led-off' }}"></span>
        </span>
    </div>

    <!-- DROITE : MENU + BURGER -->
    <div class="d-flex align-items-center gap-3">

        <!-- MENU COLLÉ AU BURGER -->
        <div id="topMenu" class="top-menu hidden">

            <a href="{{ path('home') }}">Accueil</a>
            <a href="{{ path('reservation_my') }}">Réservations</a>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_dashboard') }}">Admin</a>
            {% endif %}

            {% if app.user %}
                
                <a href="{{ path('profile_dashboard') }}">Profil</a>
                
                <a href="{{ path('logout') }}" class="text-danger" id="logoutBtn">Déconnexion</a>
            {% else %}
                <a href="{{ path('login') }}">Connexion</a>
            {% endif %}

        </div>

        <!-- BURGER -->
        <button class="btn btn-dark" id="burgerBtn">
            <span class="navbar-toggler-icon"></span>
        </button>

    </div>

</nav>

{# FLASH MESSAGES - SWAL ONLY #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="flash-message"
             data-type="{{ label }}"
             data-message="{{ message|e('html_attr') }}">
        </div>
    {% endfor %}
{% endfor %}

{# CONTENT #}
    <main class="container py-3 py-md-5">

        {% include 'partials/cookie_banner.html.twig' %}
        {% block body %}{% endblock %}

    </main>

{# FOOTER #}
    <footer class="text-center text-muted py-4 small">
        © {{ "now"|date("Y") }} EcoRide
    </footer>

    {% block javascripts %}{% endblock %}
        {{ encore_entry_script_tags('app') }}
    

</body>
</html>