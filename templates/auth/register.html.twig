{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}

<div class="container py-5" style="max-width: 650px;">

    <h2 class="text-center mb-4">Création de compte</h2>

    {# ERRORS #}
    {% if errors is defined and errors|length %}
        <div class="alert alert-danger">
            <ul class="mb-0">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <form method="post" action="{{ path('register') }}">

        {# PSEUDO #}
        <div class="mb-3">
            <label class="form-label">Pseudo</label>
            <input type="text"
                   name="pseudo"
                   class="form-control"
                   value="{{ old.pseudo|default('') }}"
                   required>
        </div>

        {# EMAIL #}
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email"
                   name="email"
                   class="form-control"
                   value="{{ old.email|default('') }}"
                   required>
        </div>

        {# PASSWORD #}
        <div class="mb-3">
            <label class="form-label">Mot de passe</label>
            <input type="password"
                   name="password"
                   class="form-control"
                   required>
        </div>

        {# CONFIRM PASSWORD #}
        <div class="mb-3">
            <label class="form-label">Confirmation mot de passe</label>
            <input type="password"
                   name="confirm_password"
                   class="form-control"
                   required>
        </div>

        {# ROLES #}
        {% set roles = old.roles|default([]) %}
        {% set isConducteur = 'conducteur' in roles %}

        <div class="mb-3">
            <label class="form-label">Type de compte</label>

            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="roles[]"
                       value="conducteur"
                       id="roleConducteur"
                       onchange="toggleCarFields()"
                       {% if isConducteur %}checked{% endif %}>
                <label class="form-check-label" for="roleConducteur">
                    Conducteur
                </label>
            </div>

            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="roles[]"
                       value="passager"
                       id="rolePassager"
                       onchange="toggleCarFields()"
                       {% if 'passager' in roles %}checked{% endif %}>
                <label class="form-check-label" for="rolePassager">
                    Passager
                </label>
            </div>
        </div>

        {# CAR FIELDS #}
        <div id="carFields" class="border rounded p-3 mb-3"
             style="display: {{ isConducteur ? 'block' : 'none' }};">

            <h6 class="mb-3">Informations véhicule</h6>

            <div class="mb-3">
                <label class="form-label">Marque</label>
                <input type="text" name="marque" class="form-control"
                       value="{{ old.marque|default('') }}">
            </div>

            <div class="mb-3">
                <label class="form-label">Modèle</label>
                <input type="text" name="modele" class="form-control"
                       value="{{ old.modele|default('') }}">
            </div>

            <div class="mb-3">
                <label class="form-label">Couleur</label>
                <input type="text" name="couleur" class="form-control"
                       value="{{ old.couleur|default('') }}">
            </div>

            <div class="mb-3">
                <label class="form-label">Énergie</label>
                <select name="energie" class="form-select">
                    <option value="">-- Choisir --</option>
                    <option value="essence" {{ app.request.get('energie') == 'essence' ? 'selected' : '' }}>Essence</option>
                    <option value="diesel" {{ app.request.get('energie') == 'diesel' ? 'selected' : ''  }}>Diesel</option>
                    <option value="electrique" {{  app.request.get('energie') == 'electrique' ? 'selected' : ''  }}>Électrique</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Places</label>
                <input type="number"
                       name="places"
                       min="1"
                       class="form-control"
                       value="{{ old.places|default('') }}">
            </div>

        </div>

        <button type="submit" class="btn btn-primary w-100">
            Créer un compte
        </button>

    </form>

    <div class="text-center mt-3">
        <p>
            Déjà inscrit ?
            <a href="{{ path('login') }}">Se connecter</a>
        </p>
    </div>

</div>

<script>
function toggleCarFields() {
    const checked = [...document.querySelectorAll('input[name="roles[]"]:checked')]
        .map(el => el.value);

    document.getElementById('carFields').style.display =
        checked.includes('conducteur') ? 'block' : 'none';
}
</script>

{% endblock %}