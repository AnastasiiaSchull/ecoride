{% extends 'base.html.twig' %}

{% block title %}Mon espace{% endblock %}

{% block body %}

<div class="container py-5">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show">
                {{ message }}
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

<div class="card shadow border-0 mb-4">

    <div class="card-body text-center">

        {% if user.photo %}
        <img
            src="{{ asset('uploads/profils/' ~ (app.user.photo ?? 'default.png')) }}"
                 alt="Photo de profil"
                 class="rounded-circle border mb-3"
                 width="150"
                 height="150"
                 style="object-fit:cover;">
        {% else %}
            <i class="bi bi-person-circle display-1 text-secondary"></i>
        {% endif %}

        <h2 class="fw-bold">
            Bienvenue, {{ user.pseudo }} !
        </h2>

    </div>
</div>

{# RÔLES #}
{% if not is_granted('ROLE_ADMIN') %}
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <i class="bi bi-person-badge me-2"></i>
        Vos rôles
    </div>

    <div class="card-body">

        {% for role in app.user.roles %}
            {% if role starts with 'ROLE_' and role != 'ROLE_USER' %}
                <span class="badge bg-primary">
                    {{ role|replace({'ROLE_': ''})|capitalize }}
                </span>
            {% endif %}
        {% endfor %}

        <div class="mt-3">
            <a href="{{ path('roles_edit') }}"
               class="btn btn-outline-primary">
                Modifier mes rôles
            </a>
        </div>

    </div>
</div>
{% endif %}
{% if is_granted('ROLE_CONDUCTEUR') or is_granted('ROLE_PASSAGER') %}

    {# PHOTO DE PROFIL #}
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <i class="bi bi-camera me-2"></i>
                Photo de profil
            </div>

            <div class="card-body text-center">

                {# AVATAR ACTUEL + FALLBACK #}
                <div class="mb-3">
                    <img
                        src="{{ asset('uploads/profils/' ~ (app.user.photo ?? 'default.png')) }}"
                        alt="Avatar"
                        class="rounded-circle shadow-sm"
                        width="120"
                        height="120"
                        style="object-fit: cover;"
                    >
                </div>

                {# FORM UPLOAD #}
                <form method="post"
                    enctype="multipart/form-data"
                    action="{{ path('profile_upload_photo') }}">

                    <div class="mb-3">
                        <input type="file"
                            name="photo"
                            class="form-control"
                            accept="image/png, image/jpeg, image/webp"
                            required>
                    </div>

                    <button class="btn btn-primary w-100">
                        Mettre à jour la photo
                    </button>

                </form>

            </div>
        </div>

    {% if is_granted('ROLE_CONDUCTEUR')%}
    {# VEHICULES #}
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <i class="bi bi-car-front me-2"></i>
            Mes véhicules
        </div>

        <div class="card-body">

            {% if vehicules %}

                <div class="table-responsive">
                    <table class="table table-striped">

                        <thead>
                        <tr>
                            <th>Marque</th>
                            <th>Modèle</th>
                            <th>Couleur</th>
                            <th>Énergie</th>
                            <th>Places</th>
                        </tr>
                        </thead>

                        <tbody>
                        {% for v in vehicules %}
                            <tr>
                                <td>{{ v.marque }}</td>
                                <td>{{ v.modele }}</td>
                                <td>{{ v.couleur }}</td>
                                <td>{{ v.energie }}</td>
                                <td>{{ v.places }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>

                    </table>
                </div>

            {% else %}

                <div class="alert alert-info">
                    Aucun véhicule enregistré.
                </div>

            {% endif %}
    
            <a href="{{ path('vehicule_create_form') }}"
               class="btn btn-success">
                <i class="bi bi-plus-circle"></i>
                Ajouter un véhicule
            </a>
    
        </div>
    </div>
    {% endif %}
{% endif %}

{# CRÉDITS #}
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <i class="bi bi-coin me-2"></i>
        Solde de crédits
    </div>

    <div class="card-body">

        <h4 class="text-success fw-bold">
            {{ credits }} crédits
        </h4>

        <a href="{{ path('profile_credits_store') }}"
           class="btn btn-warning">
            Ajouter des crédits
        </a>

    </div>
</div>

{% if creditsUtilises is not null %}
    <div class="alert alert-primary">
        <strong>{{ creditsUtilises }}</strong>
        trajet(s) réservé(s) en tant que passager.
    </div>
{% endif %}

{% if creditsGagnes is not null %}
    <div class="alert alert-success">
        <strong>{{ creditsGagnes }}</strong>
        réservation(s) reçue(s) en tant que conducteur.
    </div>
{% endif %}

{# ACTIONS #}
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <i class="bi bi-speedometer2 me-2"></i>
        Actions rapides
    </div>

    <div class="card-body d-flex flex-wrap gap-2">

        {% if 'ROLE_CONDUCTEUR' in app.user.roles %}

            <a href="{{ path('trajet_details') }}"
               class="btn btn-primary">
                Mes trajets
            </a>

            <a href="{{ path('trajet_create_form') }}"
               class="btn btn-success">
                Créer un trajet
            </a>

        {% else %}

        <a href="{{ path('reservation_my') }}"
           class="btn btn-info text-white">
            Mes réservations
        </a>
{% endif %}
    </div>
</div>

{# AVIS #}
{% if 'ROLE_PASSAGER' in app.user.roles %}

    <div class="card shadow-sm">

        <div class="card-header">
            <i class="bi bi-star-fill me-2"></i>
            Laisser un avis
        </div>

        <div class="card-body">
                {% for reservation in conducteursAvis %}
                
                <form method="post"
                    action="{{ path('avis_store', { id: reservation.id}) }}">

                    <div class="mb-3">
                        <label class="form-label">
                            Conducteur
                        </label>

                        <select name="conducteur_id"
                                class="form-select"
                                required>

                            <option value="">
                                -- Sélectionner --
                            </option>

                            {#{% for c in conducteursAvis %}
                                <option value="{{ c.trajet.id }}">
                                    {{ c.trajet.conducteur }}
                                </option>
                            {% endfor %}#}
                            {% for reservation in conducteursAvis %}
                                <option value="{{ reservation.id }}">
                                    {{ reservation.trajet }}
                                </option>
                            {% endfor %}

                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Note
                        </label>

                        <select name="note"
                                class="form-select">

                            <option value="5">⭐⭐⭐⭐⭐ Excellent</option>
                            <option value="4">⭐⭐⭐⭐ Bien</option>
                            <option value="3">⭐⭐⭐ Correct</option>
                            <option value="2">⭐⭐ Moyen</option>
                            <option value="1">⭐ Mauvais</option>

                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Commentaire
                        </label>

                        <textarea name="commentaire"
                                  class="form-control"
                                  rows="5"
                                  required></textarea>
                    </div>
                    
                    <button class="btn btn-primary">
                        Envoyer l'avis
                    </button>
                    <br><br>
                </form>
                {% endfor %}
                <br>
            

                <div class="alert alert-info mb-0">
                    Aucun conducteur à évaluer pour le moment.
                </div>

            

        </div>

    </div>

{% endif %}


</div>

{% endblock %}
