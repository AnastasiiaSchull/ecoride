{% extends 'base.html.twig' %}

{% block title %}Recherche de covoiturage - ECORIDE{% endblock %}

{% block body %}


{#<div class="container py-5">#}
{#<div class="py-5">#}

<div class="d-flex justify-content-center mb-5 text-primary fw-bold">
    <h1 class="mb-1" style="font-weight: 700; color: green">Je trouve mon EcoRIDE ...</h1>
</div>

{# ================= SEARCH FORM ================= #}
{# DEPARTURE CHOICE #}
<form method="GET" action="{{ path('covoiturage_search') }}" class="mb-4">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show">
                    {{ message }}
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
    <div class="column g-3 align-items-end justify-content-center">

        <div class="row  justify-content-center">
            <label class="form-label fw-bold">Départ</label>
            <select name="depart" class="form-select mb-4">
                <option value="">Choisir une ville</option>
                {% for ville in villesDepart|default([]) %}
                    <option value="{{ ville }}"
                        {% if depart is defined and depart == ville %}selected{% endif %}>
                        {{ ville }}
                    </option>
                {% endfor %}
            </select>
        </div>
        
        <div class="row  justify-content-center">
            <label class="form-label fw-bold">Destination</label>
            <select name="destination" class="form-select mb-4">
                <option value="">Choisir une ville</option>
                {% for ville in villesArrivee|default([]) %}
                    <option value="{{ ville }}"
                        {% if destination is defined and destination == ville %}selected{% endif %}>
                        {{ ville }}
                    </option>
                {% endfor %}
            </select>
        </div>
        
        <div class="row  justify-content-center">
            <label class="form-label fw-bold">Date</label>
            <input type="date"
                   name="date"
                   class="form-control mb-4"
                   value="">
        </div>

        <div class="row  justify-content-center">
            <label class="form-label fw-bold">Passagers</label>
            <input type="number"
                   name="passager"
                   min="1"
                   max="8"
                   class="form-control"
                   value="{{ passager|default(1) }}">
        </div>
        
        <div class="row  justify-content-center mt-2">
            <div class="d-grid mt-3">
                <button type="submit" class="btn btn-primary">
                    Rechercher
                </button>
            </div>
        </div>

    </div>
</form>

    {# ================= TITLE ================= #}
    <h3 class="mt-5 mb-3 text-center">
        Résultats — {{ trajetTitre|default('Trajets') }}
    </h3>

    {# ================= RESULTS ================= #}
    {% if trajetsAVenir is empty %}

        <div class="alert alert-warning">
            Aucun trajet trouvé pour cette recherche.
        </div>

    {% else %}

        <div class="row g-3">

            {% for trajet in trajetsAVenir %}

                <div class="col-12">

                    <div class="card shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between">

                                {# TIMES #}
                                <div>

                                    <div class="fw-bold">
                                        {{ trajet.dateDepart|date('H:i') }}
                                        →
                                        {{ trajet.dateArrivee|date('H:i') }}
                                    </div>

                                    <div class="text-muted">
                                        {{ trajet.villeDepart }}
                                        →
                                        {{ trajet.villeArrivee }}
                                    </div>

                                </div>

                                {# PRIX #}
                                <div class="text-end">
                                    <h4 class="text-primary mb-0">
                                        {{ trajet.prix }} €
                                    </h4>
                                </div>

                            </div>

                            <hr>

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <div>
                                        Conducteur :
                                        <strong>{{ trajet.conducteur_nom|default('—') }}</strong>
                                        ⭐ {{ trajet.conducteur_note|default('–') }}
                                    </div>

                                    <div>
                                        Places restantes :
                                        {{ trajet.placesDispo }}
                                    </div>
                                </div>
                                <br>
                                <div class="d-flex gap-2">

                                    <a href="{{ path('covoiturage_show', {id: trajet.id}) }}"
                                       class="btn btn-outline-primary btn-sm">
                                        Détails
                                    </a>
                                    <br><br>
                                    {% if trajet.placesDispo > 0 %}

                                        {% if app.user %}

                                            <form method="post" action="{{ path('reservation_create') }}">
                                                <input type="hidden" name="trajet_id" value="{{ trajet.id }}">
                                                <button class="btn btn-primary btn-sm">
                                                    Réserver
                                                </button>
                                            </form>

                                        {% else %}
                                    <br>

                                            <a href="#" class="btn btn-secondary btn-sm login-trigger">
                                                Connexion
                                            </a>

                                        {% endif %}

                                    {% else %}

                                        <button class="btn btn-dark btn-sm" disabled>
                                            Complet
                                        </button>

                                    {% endif %}

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            {% endfor %}

        </div>

    {% endif %}

{#</div>#}

<script>
document.addEventListener('DOMContentLoaded', function () {

    document.querySelectorAll('.login-trigger').forEach(button => {

        button.addEventListener('click', async function (e) {
            e.preventDefault();

            const { value: formValues } = await Swal.fire({
                title: 'Connexion',
                html:
                    '<input id="swal-email" class="swal2-input" placeholder="Email">' +
                    '<input id="swal-password" type="password" class="swal2-input" placeholder="Mot de passe">',
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Se connecter',
                preConfirm: () => {
                    return {
                        email: document.getElementById('swal-email').value,
                        password: document.getElementById('swal-password').value
                    };
                }
            });

            if (!formValues) return;

            try {

                const response = await fetch("{{ path('ajax_login') }}", {
                    method: "POST",
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formValues)
                });

                const data = await response.json();

                if (data.success) {

                    await Swal.fire({
                        icon: 'success',
                        title: 'Connecté !',
                        timer: 1200,
                        showConfirmButton: false
                    });

                    // simple refresh propre
                    window.location.reload();

                } else {

                    Swal.fire({
                        icon: 'error',
                        title: 'Erreur',
                        text: data.message
                    });

                }

            } catch (error) {

                Swal.fire({
                    icon: 'error',
                    title: 'Erreur serveur',
                    text: 'Impossible de se connecter'
                });

            }

        });

    });

});
</script>

{% endblock %}