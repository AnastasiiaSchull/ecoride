{% extends 'base.html.twig' %}

{% block title %}EcoRide{% endblock %}

{% block body %}

<div class="container-fluid p-0">

```
{# HERO #}
<div class="position-relative">

    <img src="{{ asset('images/hero.jpg') }}"
         class="img-fluid w-100"
         style="height: 350px; object-fit: cover;"
         alt="EcoRide">

    <div class="position-absolute top-50 start-50 translate-middle text-center text-white">

        <h1 class="d-none d-md-block fw-bold">
            Bienvenue chez EcoRide
        </h1>

        <h1 class="d-md-none fw-bold">
            Eco-Covoiturage
        </h1>

    </div>

</div>
```

</div>

<div class="container py-5">

```
<div class="card shadow-sm">

    <div class="card-body">

        <h2 class="text-center mb-4">
            Recherche d'un trajet
        </h2>

        <form action="{{ path('app_covoiturages') }}"
              method="get"
              class="row g-3">

            <div class="col-md-6">

                <label class="form-label">
                    Départ
                </label>

                <select name="depart"
                        class="form-select">

                    <option value="">
                        Choisir une ville
                    </option>

                    {% for ville in villesDepart %}
                        <option value="{{ ville }}">
                            {{ ville }}
                        </option>
                    {% endfor %}

                </select>

            </div>

            <div class="col-md-6">

                <label class="form-label">
                    Destination
                </label>

                <select name="destination"
                        class="form-select">

                    <option value="">
                        Choisir une ville
                    </option>

                    {% for ville in villesArrivee %}
                        <option value="{{ ville }}">
                            {{ ville }}
                        </option>
                    {% endfor %}

                </select>

            </div>

            <div class="col-md-6">

                <label class="form-label">
                    Date
                </label>

                <input type="date"
                       name="date"
                       class="form-control"
                       value="{{ 'now'|date('Y-m-d') }}">

            </div>

            <div class="col-md-6">

                <label class="form-label">
                    Nombre de passagers
                </label>

                <input type="number"
                       name="passager"
                       min="1"
                       max="8"
                       value="1"
                       class="form-control">

            </div>

            <div class="col-12 text-center">

                <button type="submit"
                        class="btn btn-primary px-5">

                    <i class="bi bi-search me-2"></i>
                    Rechercher

                </button>

            </div>

        </form>

    </div>

</div>

<hr class="my-5">

{# TRAJETS A VENIR #}
<div class="card shadow-sm">

    <div class="card-header d-flex justify-content-between align-items-center"
         data-bs-toggle="collapse"
         data-bs-target="#trajetsCollapse"
         style="cursor:pointer;">

        <h4 class="mb-0">
            Trajets à venir
        </h4>

        <i class="bi bi-chevron-down"></i>

    </div>

    <div id="trajetsCollapse"
         class="collapse">

        <div class="card-body">

            {% if trajetsAVenir is not empty %}

                <div class="row g-3">

                    {% for t in trajetsAVenir %}

                        <div class="col-md-4">

                            <a href="{{ path('app_covoiturages', {
                                depart: t.ville_depart,
                                destination: t.ville_arrivee,
                                date: t.prochaine_date|date('Y-m-d'),
                                passager: 1
                            }) }}"
                               class="text-decoration-none">

                                <div class="card h-100 border-primary">

                                    <div class="card-body text-center">

                                        <h5>
                                            {{ t.ville_depart }}
                                        </h5>

                                        <div class="fs-4">
                                            →
                                        </div>

                                        <h5>
                                            {{ t.ville_arrivee }}
                                        </h5>

                                        <small class="text-muted">

                                            {{ t.prochaine_date|date('d/m/Y') }}

                                        </small>

                                    </div>

                                </div>

                            </a>

                        </div>

                    {% endfor %}

                </div>

            {% else %}

                <div class="alert alert-info mb-0">
                    Aucun trajet à venir.
                </div>

            {% endif %}

        </div>

    </div>

</div>
```

</div>

{% endblock %}