{% extends 'base.html.twig' %}

{% block title %}Mon espace{% endblock %}

{% block body %}

<div class="container py-5">

```
<div class="card shadow border-0 mb-4">
    <div class="card-body text-center">

        {% if user.photo %}
            <img src="{{ asset('uploads/' ~ user.photo) }}"
                 alt="Photo de profil"
                 class="rounded-circle border mb-3"
                 width="150"
                 height="150"
                 style="object-fit:cover;">
        {% else %}
            <i class="bi bi-person-circle display-1 text-secondary"></i>
        {% endif %}

        <h2 class="fw-bold">
            Bienvenue, {{ user.pseudo }} !
        </h2>

    </div>
</div>

{# RÔLES #}
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <i class="bi bi-person-badge me-2"></i>
        Vos rôles
    </div>

    <div class="card-body">

        {% for role in roles %}
            <span class="badge bg-primary me-2">
                {{ role|capitalize }}
            </span>
        {% endfor %}

        <div class="mt-3">
            <a href="{{ path('app_roles_edit') }}"
               class="btn btn-outline-primary">
                Modifier mes rôles
            </a>
        </div>

    </div>
</div>

{% if 'conducteur' in roles %}

    {# PHOTO #}
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <i class="bi bi-camera me-2"></i>
            Photo de profil
        </div>

        <div class="card-body">

            <form method="post"
                  enctype="multipart/form-data"
                  action="{{ path('app_upload_photo') }}">

                <div class="mb-3">
                    <input type="file"
                           name="photo"
                           class="form-control"
                           accept="image/*"
                           required>
                </div>

                <button class="btn btn-primary">
                    Mettre à jour
                </button>

            </form>

        </div>
    </div>

    {# VEHICULES #}
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <i class="bi bi-car-front me-2"></i>
            Mes véhicules
        </div>

        <div class="card-body">

            {% if vehicules %}

                <div class="table-responsive">
                    <table class="table table-striped">

                        <thead>
                        <tr>
                            <th>Marque</th>
                            <th>Modèle</th>
                            <th>Couleur</th>
                            <th>Énergie</th>
                            <th>Places</th>
                        </tr>
                        </thead>

                        <tbody>
                        {% for v in vehicules %}
                            <tr>
                                <td>{{ v.marque }}</td>
                                <td>{{ v.modele }}</td>
                                <td>{{ v.couleur }}</td>
                                <td>{{ v.energie }}</td>
                                <td>{{ v.places }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>

                    </table>
                </div>

            {% else %}

                <div class="alert alert-info">
                    Aucun véhicule enregistré.
                </div>

            {% endif %}

            <a href="{{ path('app_vehicule_create') }}"
               class="btn btn-success">
                <i class="bi bi-plus-circle"></i>
                Ajouter un véhicule
            </a>

        </div>
    </div>

{% endif %}

{# CRÉDITS #}
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <i class="bi bi-coin me-2"></i>
        Solde de crédits
    </div>

    <div class="card-body">

        <h4 class="text-success fw-bold">
            {{ credits }} crédits
        </h4>

        <a href="{{ path('app_credits') }}"
           class="btn btn-warning">
            Ajouter des crédits
        </a>

    </div>
</div>

{% if credits_utilises is not null %}
    <div class="alert alert-primary">
        <strong>{{ credits_utilises }}</strong>
        trajet(s) réservé(s) en tant que passager.
    </div>
{% endif %}

{% if credits_gagnes is not null %}
    <div class="alert alert-success">
        <strong>{{ credits_gagnes }}</strong>
        réservation(s) reçue(s) en tant que conducteur.
    </div>
{% endif %}

{# ACTIONS #}
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <i class="bi bi-speedometer2 me-2"></i>
        Actions rapides
    </div>

    <div class="card-body d-flex flex-wrap gap-2">

        {% if 'conducteur' in roles %}

            <a href="{{ path('app_mes_trajets') }}"
               class="btn btn-primary">
                Mes trajets
            </a>

            <a href="{{ path('app_trajet_create') }}"
               class="btn btn-success">
                Créer un trajet
            </a>

        {% endif %}

        <a href="{{ path('app_mes_reservations') }}"
           class="btn btn-info text-white">
            Mes réservations
        </a>

    </div>
</div>

{# AVIS #}
{% if 'passager' in roles %}

    <div class="card shadow-sm">

        <div class="card-header">
            <i class="bi bi-star-fill me-2"></i>
            Laisser un avis
        </div>

        <div class="card-body">

            {% if conducteursAvis %}

                <form method="post"
                      action="{{ path('app_avis_create') }}">

                    <div class="mb-3">
                        <label class="form-label">
                            Conducteur
                        </label>

                        <select name="conducteur_id"
                                class="form-select"
                                required>

                            <option value="">
                                -- Sélectionner --
                            </option>

                            {% for c in conducteursAvis %}
                                <option value="{{ c.id }}">
                                    {{ c.pseudo }}
                                </option>
                            {% endfor %}

                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Note
                        </label>

                        <select name="note"
                                class="form-select">

                            <option value="5">⭐⭐⭐⭐⭐ Excellent</option>
                            <option value="4">⭐⭐⭐⭐ Bien</option>
                            <option value="3">⭐⭐⭐ Correct</option>
                            <option value="2">⭐⭐ Moyen</option>
                            <option value="1">⭐ Mauvais</option>

                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Commentaire
                        </label>

                        <textarea name="commentaire"
                                  class="form-control"
                                  rows="5"
                                  required></textarea>
                    </div>

                    <button class="btn btn-primary">
                        Envoyer l'avis
                    </button>

                </form>

            {% else %}

                <div class="alert alert-info mb-0">
                    Aucun conducteur à évaluer pour le moment.
                </div>

            {% endif %}

        </div>

    </div>

{% endif %}
```

</div>

{% endblock %}