{% extends 'base.html.twig' %}

{% block title %}Modifier mes rôles{% endblock %}

{% block body %}

<div class="container py-5">

```
<div class="row justify-content-center">

    <div class="col-md-8 col-lg-6">

        <div class="card shadow border-0">

            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">
                    <i class="bi bi-person-gear me-2"></i>
                    Modifier mes rôles
                </h3>
            </div>

            <div class="card-body">

                <form method="post"
                      action="{{ path('app_roles_update') }}">

                    {% for role in all %}

                        <div class="form-check mb-3">

                            <input
                                class="form-check-input"
                                type="checkbox"
                                name="roles[]"
                                value="{{ role.nom }}"
                                id="role_{{ role.nom }}"
                                {% if role.nom in current %}checked{% endif %}
                            >

                            <label class="form-check-label"
                                   for="role_{{ role.nom }}">

                                {{ role.label }}

                            </label>

                        </div>

                    {% endfor %}

                    <div class="d-grid mt-4">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check-circle me-2"></i>
                            Enregistrer

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
```

</div>

{% endblock %}